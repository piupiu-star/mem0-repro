# Copy this file to .env and fill in the key. .env is gitignored.
# Get a key at https://platform.deepseek.com  (existing key from the FTEC5660 folder works).

DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_API_BASE=https://api.deepseek.com

# --- controlled variables (report section 2) ---
REPRO_LLM_MODEL=deepseek-chat
REPRO_EMBEDDER_PROVIDER=fastembed
REPRO_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
REPRO_EMBEDDER_DIMS=384
REPRO_TEMPERATURE=0.0
REPRO_ANSWER_MAX_TOKENS=600
REPRO_JUDGE_MAX_TOKENS=120

# --- budget guard (USD per 1M tokens) ---
REPRO_PRICE_IN=0.27
REPRO_PRICE_OUT=1.10
REPRO_BUDGET_CAP=2.50
REPRO_BUDGET_FLOOR=1.00
